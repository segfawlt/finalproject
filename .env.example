# Database
DATABASE_URL=postgresql://dev:dev@localhost:5432/discord_platform

# Discord OAuth2 (Better Auth)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token

# Server
PORT=3001
NODE_ENV=development

# Auth
BETTER_AUTH_SECRET=your_random_secret_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5173/api/auth

# LLM Provider (OpenRouter or any OpenAI-compatible endpoint)
# Leave LLM_API_KEY unset in development to use the mock planner.
# Guilds with configured server rules cannot execute until a key is supplied,
# because execution-time policy validation fails closed.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Web App URL (where the SPA is served from, used for OAuth callbacks and OpenRouter ranking)
WEB_APP_URL=http://localhost:5173

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@playwright/mcp",
        "--executable-path",
        "/usr/sbin/chromium"
      ],
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "description": "Semantic codebase exploration",
      "mode": "subagent",
      "permission": { "edit": "deny", "task": "deny" },
      "prompt": "{file:./.opencode/prompts/explore-guideline.md}"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "subagent",
      "hidden": true,
      "permission": { "edit": "deny", "task": "deny" },
      "prompt": "{file:./.opencode/prompts/executor-guideline.md}"
    }
  }
}

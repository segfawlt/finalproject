{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@playwright/mcp",
        "--executable-path",
        "/usr/sbin/chromium"
      ],
      "enabled": false
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6LGTVqowbzYwv1yNIyF0vDgXdd9C0JluTJadL1f3tVsTA"
      }
    }
  },
  "agent": {
    "explore": {
      "description": "Semantic codebase exploration",
      "mode": "subagent",
      "permission": { "edit": "deny", "task": "deny" },
      "prompt": "{file:./.opencode/prompts/explore-guideline.md}"
    },
    "executor": {
      "description": "Fast scoped worker for bounded implementation, focused tests, and validation",
      "model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "permission": { "task": "deny" },
      "prompt": "{file:./.opencode/prompts/executor-guideline.md}"
    }
  }
}

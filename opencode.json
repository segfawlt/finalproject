{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "agent": {
    "general": {
      "model": "opencode-go/deepseek-v4-pro",
      "options": {
        "thinking": { "type": "enabled" }
      }
    }
  },
  "mcp": {
    "grepai": {
      "type": "local",
      "command": ["grepai", "mcp-serve"],
      "enabled": true
    }
  }
}
